{
  "name": "task-done-notify",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Arm a session; when its turn finishes, push a WeChat (ServerChan) and DingTalk webhook notification.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js",
    "prepack": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}