{
  "name": "@local/task-done-notify",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Arm a session; when its turn finishes, push a WeChat (ServerChan) and DingTalk webhook notification.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}