{
  "name": "task-done-notify",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "Native macOS banner in DSH's own name (whale icon) on every top-level turn completion, showing the turn's reply summary; independent of the bell. Arm a session to also push WeChat (ServerChan) and DingTalk notifications.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js",
    "prepack": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}